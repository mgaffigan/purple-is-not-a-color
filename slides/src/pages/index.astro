---
import '../styles/global.css';
import SoundLab from '../scenes/SoundLab.astro';
import Wavelets from '../scenes/Wavelets.astro';
import LightLab from '../scenes/LightLab.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>Purple is not a color</title>
  </head>
  <body>
    <div class="reveal">
      <div class="slides">
        <!-- Persistent scenes live outside <section>s so they survive slide changes. -->
        <div class="labs">
          <SoundLab />
          <Wavelets />
          <LightLab />
        </div>

        <!-- ================= SOUND ================= -->
        <section data-scene="sound" data-stage="title">
          <aside class="notes">
            <ul>
              <li>Pants, close your eyes, colorblind</li>
              <li>The color vs the human experience of the color</li>
              <li>Vision is weird for a lot of reasons we'll get into</li>
              <li>Sound is easier to talk about</li>
            </ul>
          </aside>
        </section>

        <section data-scene="sound" data-stage="A">
          <h2 class="slide-title">Sound is power at frequency</h2>
          <aside class="notes">
            <ul>
              <li>Time-series</li>
              <li>Frequency = Waterfall, whistle</li>
              <li>Our perception is really good
                <ul>
                  <li>Continuous</li>
                  <li>Chords</li>
                  <li>Not unlimited</li>
                </ul>
              </li>
            </ul>
          </aside>
        </section>

        <section data-scene="sound" data-stage="B">
          <h2 class="slide-title">Take some away: the EQ</h2>
          <aside class="notes">
            <ul>
              <li>Useful to understand filters and noise
                <ul>
                  <li>Chords have sound at multiple points, Noise is every sound all at once</li>
                  <li>Filters let you remove</li>
                </ul>
              </li>
            </ul>
          </aside>
        </section>

        <!-- ================= WIBBLY WOBBLY ================= -->
        <section data-scene="waves" data-stage="main">
          <aside class="notes">
            <ul>
              <li>What is light</li>
            </ul>
          </aside>
        </section>

        <!-- ================= LIGHT ================= -->
        <section data-scene="light" data-stage="A">
          <h2 class="slide-title">Light is power at frequency</h2>
          <aside class="notes">
            <ul>
              <li>Much like sound, light has frequency and power</li>
              <li>The measurable aspect of color is the frequency</li>
              <li>Light is generated by something (LED, laser, the sun, fluorescent)</li>
              <li>Note that white light is noise - power at many frequencies</li>
            </ul>
          </aside>
        </section>

        <section data-scene="light" data-stage="B">
          <h2 class="slide-title">Take some away: filters &amp; paints</h2>
          <aside class="notes">
            <ul>
              <li>Paint and filters absorb colors from light - what's reflected we see</li>
              <li>Sunlight on tomato</li>
              <li>Red light on tomato</li>
              <li>Blue light on tomato</li>
              <li>Sage with fluorescent</li>
            </ul>
          </aside>
        </section>

        <section data-scene="light" data-stage="C">
          <h2 class="slide-title">What the eye actually sends</h2>
          <aside class="notes">
            <ul>
              <li>Our color perception is not continuous</li>
              <li>Relative difference between three colors, plus how bright things are</li>
              <li>Colorblind</li>
              <li>Glissando</li>
              <li>Red vs mixed red (can't hear chords)</li>
            </ul>
          </aside>
        </section>

        <section data-scene="light" data-stage="purple">
          <h2 class="slide-title">Purple</h2>
          <span class="fragment"><span class="headline">Purple is a <em>chord</em>.</span></span>
          <aside class="notes">
            <ul>
              <li>Except when we can</li>
              <li>→ Purple is a chord</li>
            </ul>
          </aside>
        </section>
      </div>
    </div>

    <div class="arm-badge">🔈 click to arm audio</div>

    <script>
      import { initDeck } from '../lib/deck';
      import { SoundScene } from '../scenes/sound';
      import { WaveletScene } from '../scenes/wavelets';
      import { LightScene } from '../scenes/light';

      const q = (s: string) => document.querySelector<HTMLElement>(s)!;
      initDeck({
        sound: new SoundScene(q('.lab.sound')),
        waves: new WaveletScene(q('.lab.waves')),
        light: new LightScene(q('.lab.light')),
      });
    </script>
  </body>
</html>
